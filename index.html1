<title>AMAYRA SMART MEMBERSHIP</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}
<script>

document.getElementById("membershipForm").addEventListener("submit", function(e){

e.preventDefault();

alert("🎉 Welcome to AMAYRA CAR WASH Family!\n\nRegistration Successful.");

