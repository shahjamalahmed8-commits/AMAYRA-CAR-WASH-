body{
background:#000;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
padding:20px;
}

.container{

background:#111;
width:100%;
max-width:420px;

border-radius:20px;
padding:25px;

text-align:center;

border:2px solid red;

box-shadow:0 0 25px rgba(255,0,0,.5);

}

.logo{

width:170px;

border-radius:20px;

margin-bottom:20px;

}

h1{

color:#ffffff;

font-size:30px;

margin-bottom:10px;

}

h2{

color:#ff0000;

margin-bottom:20px;

}

p{

color:#cccccc;

font-size:16px;

line-height:26px;

margin-bottom:25px;

}

.btn{

display:block;

background:red;

color:white;

text-decoration:none;

padding:16px;

font-size:20px;

border-radius:12px;

font-weight:bold;

}

input,
select{
width:100%;
padding:14px;
margin:10px 0;
border:none;
border-radius:10px;
font-size:16px;
background:#fff;
color:#000;
}

button{
width:100%;
padding:15px;
margin-top:15px;
background:red;
color:white;
border:none;
border-radius:10px;
font-size:18px;
font-weight:bold;
cursor:pointer;
}footer{

margin-top:30px;

font-size:13px;

color:#888;

}

</style>

</head>

<body>

<div class="container">

<img src="image.jpg" class="logo">

